{
  "name": "second-brain-mcp",
  "version": "0.1.1",
  "description": "Persistent memory MCP server with SQLite FTS5 + curator + skills",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "brain": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "setup",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "sqlite",
    "fts5",
    "claude",
    "ai-agent"
  ],
  "author": "giovani-junior-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giovani-junior-dev/second-brain-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@vitest/coverage-v8": "^2.1.8",
    "better-sqlite3": "^12.10.0",
    "msw": "^2.14.6",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "zod": "^4.4.3"
  }
}
